# Safe local-development template. Replace only with non-secret URLs.
NEXT_PUBLIC_SITE_URL=<public-storefront-url>
API_BASE_URL=<backend-url>/api/v1

# Supabase publishable/anon key for browser-to-private-bucket signed uploads.
# This key is intentionally public; never put a service-role key in the frontend.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-or-publishable-key>

# Google Analytics 4 Measurement ID (public tag ID, not a secret).
# Set this on the frontend Vercel project for Production and Preview.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional MP4/WebM background film for the homepage hero.
# Prefer a public, optimized video stored in the Supabase product-media bucket.
NEXT_PUBLIC_HERO_VIDEO_URL=
