# Safe local-development template. Replace every placeholder in your local
# backend/.env; never put production values in this file.
NODE_ENV=<development-or-production>
PORT=<local-port>
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>?schema=public
SESSION_SECRET=<random-secret-at-least-32-characters>
FRONTEND_ORIGIN=<storefront-origin>
TRUST_PROXY=<true-or-false>

# Optional backend runtime integrations. Keep credentials server-side.
META_WHATSAPP_TOKEN=<optional-server-side-token>
META_WHATSAPP_PHONE_ID=<optional-provider-phone-id>
WHATSAPP_APP_SECRET=<webhook-signing-secret>
WHATSAPP_VERIFY_TOKEN=<random-webhook-verification-token>
OPENAI_API_KEY=<optional-server-side-provider-key>

# Payment-proof storage; create this as a PRIVATE Supabase Storage bucket.
# Keep the service-role key only in backend/.env / backend Vercel environment variables.
SUPABASE_URL=<https://your-project.supabase.co>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
PAYMENT_PROOFS_BUCKET=payment-proofs

# Public product-photo bucket. Keep separate from the private payment-proofs bucket.
SUPABASE_PUBLIC_MEDIA_BUCKET=product-media

# Protect the scheduled Vercel Cron endpoint (minimum 32 random characters).
CRON_SECRET=<random-cron-secret-at-least-32-characters>
